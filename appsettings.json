{
  "Urls": "http://localhost:5000",
  "AllowedHosts": "localhost;127.0.0.1",
  "Platform": {
    "DataDirectory": "data",
    "PublicUrl": "http://localhost:5000",
    "MaxTeamMembers": 5,
    "MaxSupervisorTeams": 3,
    "MaxUploadMegabytes": 10,
    "DemoData": true
  },
  "Similarity": {
    "Engine": "Python",
    "PythonExecutable": ".tools/python/python.exe",
    "TimeoutSeconds": 5,
    "MaxConcurrentWorkers": 2,
    "MaxCorpusDocuments": 5000,
    "MaxResults": 10,
    "AllowFallback": true
  },
  "Mail": {
    "Mode": "Local",
    "Host": "",
    "Port": 587,
    "UseTls": true,
    "FromAddress": "graduation@localhost",
    "FromName": "منصة مشروعات التخرج"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
